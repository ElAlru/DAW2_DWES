      "body {",
      "\tfont-family: ${1:'Segoe UI', Tahoma, Geneva, Verdana, sans-serif};",
      "\tline-height: 1.6;",
      "\tcolor: ${2:#333};",
      "\tbackground-color: ${3:#fff};",
      "}",
      "",
      "img {",
      "\tmax-width: 100%;",
      "\theight: auto;",
      "\tdisplay: block;",
      "}",
      "",
      "a {",
      "\ttext-decoration: none;",
      "\tcolor: inherit;",
      "}",
      "",
      "ul, ol {",
      "\tlist-style: none;",
      "}",
      "$0"
    ],
    "description": "Reset CSS básico para empezar un proyecto"
  },
  "Normalize links": {
    "prefix": "normlinks",
    "body": [
      "a {",
      "\ttext-decoration: none;",
      "\tcolor: ${1:#3498db};",
      "}",
      "",
      "a:hover {",
      "\tcolor: ${2:#2980b9};",
