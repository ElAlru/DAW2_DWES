      "\t<p>${1:Cita}</p>",
      "\t<cite>${2:Autor}</cite>",
      "</blockquote>$0"
    ],
    "description": "Cita con blockquote"
  },
  "Pre + Code": {
    "prefix": "precode",
    "body": [
      "<pre><code>",
      "${1:código}",
      "</code></pre>$0"
    ],
    "description": "Bloque de código preformateado"
  },
  "Abbr": {
    "prefix": "abbr",
    "body": "<abbr title=\"${1:significado completo}\">${2:ABREVIATURA}</abbr>$0",
    "description": "Abreviatura con title"
  },
  "Br y Hr": {
    "prefix": "br",
    "body": "<br>$0",
    "description": "Salto de línea"
  },
  "Línea horizontal": {
    "prefix": "hr",
    "body": "<hr>$0",
    "description": "Línea horizontal <hr>"
  },
  "Sub (subíndice)": {
    "prefix": "sub",
    "body": "<sub>${1:subíndice}</sub>$0",
    "description": "Texto en subíndice"
  },
  "Sup (superíndice)": {
    "prefix": "sup",
    "body": "<sup>${1:superíndice}</sup>$0",
    "description": "Texto en superíndice"
  },
  "Del (tachado)": {
    "prefix": "del",
    "body": "<del>${1:texto eliminado}</del>$0",
    "description": "Texto tachado/eliminado"
  },
  "Ins (insertado)": {
    "prefix": "ins",
    "body": "<ins>${1:texto insertado}</ins>$0",
    "description": "Texto insertado"
  },

