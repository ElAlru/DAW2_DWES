  // ══════════════════════════════════════════════
  // ██  TABLAS                                  ██
  // ══════════════════════════════════════════════

  "Tabla básica": {
    "prefix": "table",
    "body": [
      "<table>",
      "\t<thead>",
      "\t\t<tr>",
      "\t\t\t<th>${1:Cabecera 1}</th>",
      "\t\t\t<th>${2:Cabecera 2}</th>",
      "\t\t\t<th>${3:Cabecera 3}</th>",
      "\t\t</tr>",
      "\t</thead>",
      "\t<tbody>",
      "\t\t<tr>",
      "\t\t\t<td>${4:Dato 1}</td>",
      "\t\t\t<td>${5:Dato 2}</td>",
      "\t\t\t<td>${6:Dato 3}</td>",
      "\t\t</tr>",
      "\t\t$0",
      "\t</tbody>",
      "</table>"
    ],
    "description": "Tabla con thead y tbody"
  },
  "Tabla completa": {
    "prefix": "tablefull",
    "body": [
      "<table>",
      "\t<caption>${1:Título de la tabla}</caption>",
      "\t<thead>",
      "\t\t<tr>",
      "\t\t\t<th>${2:Cabecera 1}</th>",
