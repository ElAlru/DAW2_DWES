  "Heading h1": {
    "prefix": "h1",
    "body": "<h1>${1:Título}</h1>$0",
    "description": "Encabezado h1"
  },
  "Heading h2": {
    "prefix": "h2",
    "body": "<h2>${1:Subtítulo}</h2>$0",
    "description": "Encabezado h2"
  },
  "Heading h3": {
    "prefix": "h3",
    "body": "<h3>${1:Subtítulo}</h3>$0",
    "description": "Encabezado h3"
  },
  "Párrafo": {
    "prefix": "pp",
    "body": "<p>${1:Texto del párrafo}</p>$0",
    "description": "Párrafo <p>"
  },
  "Span": {
    "prefix": "sp",
    "body": "<span${1: class=\"${2:clase}\"}>${3:texto}</span>$0",
    "description": "Etiqueta <span>"
  },
  "Strong (negrita)": {
    "prefix": "str",
    "body": "<strong>${1:texto en negrita}</strong>$0",
    "description": "Texto en negrita semántico"
  },
  "Em (cursiva)": {
    "prefix": "em",
    "body": "<em>${1:texto en cursiva}</em>$0",
    "description": "Texto en cursiva semántico"
  },
  "Mark (resaltado)": {
    "prefix": "mark",
    "body": "<mark>${1:texto resaltado}</mark>$0",
    "description": "Texto resaltado"
  },
  "Small": {
    "prefix": "sm",
    "body": "<small>${1:texto pequeño}</small>$0",
    "description": "Texto pequeño"
  },
