    "prefix": "tr",
    "body": [
      "<tr>",
      "\t<td>${1:Dato 1}</td>",
      "\t<td>${2:Dato 2}</td>",
      "\t<td>${3:Dato 3}</td>",
      "</tr>$0"
    ],
    "description": "Fila de tabla <tr>"
  },
