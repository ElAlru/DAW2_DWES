  // ══════════════════════════════════════════════
  // ██  META TAGS                               ██
  // ══════════════════════════════════════════════

  "Meta charset": {
    "prefix": "metach",
    "body": "<meta charset=\"${1:UTF-8}\">$0",
    "description": "Meta charset"
  },
  "Meta viewport": {
    "prefix": "metavp",
    "body": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">$0",
    "description": "Meta viewport responsive"
  },
  "Meta description": {
    "prefix": "metadesc",
    "body": "<meta name=\"description\" content=\"${1:Descripción de la página}\">$0",
    "description": "Meta description para SEO"
  },
  "Meta author": {
    "prefix": "metaaut",
    "body": "<meta name=\"author\" content=\"${1:Nombre del autor}\">$0",
    "description": "Meta author"
  },
  "Meta keywords": {
    "prefix": "metakey",
    "body": "<meta name=\"keywords\" content=\"${1:palabra1, palabra2, palabra3}\">$0",
    "description": "Meta keywords"
  },
  "Meta refresh": {
    "prefix": "metaref",
    "body": "<meta http-equiv=\"refresh\" content=\"${1:5};url=${2:https://ejemplo.com}\">$0",
    "description": "Meta refresh - redirige tras X segundos"
  },
  "Favicon link": {
    "prefix": "favicon",
    "body": "<link rel=\"icon\" type=\"image/x-icon\" href=\"${1:favicon.ico}\">$0",
    "description": "Enlace al favicon"
  },

