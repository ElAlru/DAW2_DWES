{
  // ══════════════════════════════════════════════
  // ██  ESTRUCTURAS BASE HTML                  ██
  // ══════════════════════════════════════════════

  "HTML5 base": {
    "prefix": "html5",
    "body": [
      "<!DOCTYPE html>",
      "<html lang=\"es\">",
      "<head>",
      "\t<meta charset=\"UTF-8\">",
      "\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">",
      "\t<title>${1:Título}</title>",
      "</head>",
      "<body>",
      "\t$0",
      "</body>",
      "</html>"
    ],
    "description": "Plantilla HTML5 básica en español"
  },
  "HTML5 con CSS": {
    "prefix": "html5css",
    "body": [
      "<!DOCTYPE html>",
      "<html lang=\"es\">",
      "<head>",
      "\t<meta charset=\"UTF-8\">",
      "\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">",
      "\t<title>${1:Título}</title>",
      "\t<link rel=\"stylesheet\" href=\"${2:styles.css}\">",
      "</head>",
      "<body>",
      "\t$0",
      "</body>",
      "</html>"
