      "<html lang=\"es\">",
      "<head>",
      "\t<meta charset=\"UTF-8\">",
      "\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">",
      "\t<title>${1:Título}</title>",
      "\t<link rel=\"stylesheet\" href=\"${2:styles.css}\">",
      "</head>",
      "<body>",
      "\t$3",
      "\t<script src=\"${4:script.js}\"></script>",
      "</body>",
      "</html>"
    ],
    "description": "Plantilla HTML5 completa con CSS y JS externos"
  },
  "HTML5 con style interno": {
    "prefix": "html5style",
    "body": [
      "<!DOCTYPE html>",
      "<html lang=\"es\">",
      "<head>",
      "\t<meta charset=\"UTF-8\">",
      "\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">",
      "\t<title>${1:Título}</title>",
