    "prefix": "tdcol",
    "body": "<td colspan=\"${1:2}\">${2:Dato}</td>$0",
    "description": "Celda con colspan"
  },
  "Celda con rowspan": {
    "prefix": "tdrow",
    "body": "<td rowspan=\"${1:2}\">${2:Dato}</td>$0",
    "description": "Celda con rowspan"
  },
  "Colgroup": {
    "prefix": "colgroup",
    "body": [
      "<colgroup>",
      "\t<col style=\"${1:background-color: #f0f0f0}\">",
