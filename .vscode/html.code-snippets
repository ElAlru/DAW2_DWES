    "prefix": "linkcss",
    "body": "<link rel=\"stylesheet\" href=\"${1:styles.css}\">$0",
    "description": "Enlace a hoja de estilos CSS"
  },
  "Script externo": {
    "prefix": "scriptsrc",
    "body": "<script src=\"${1:script.js}\"></script>$0",
    "description": "Script externo"
  },
  "Script inline": {
    "prefix": "scriptinl",
    "body": [
      "<script>",
      "\t$0",
      "</script>"
    ],
    "description": "Bloque script inline"
  },
  "Style inline": {
    "prefix": "styleinl",
    "body": [
      "<style>",
      "\t$0",
      "</style>"
    ],
    "description": "Bloque style inline"
  },
  "Enlace a": {
    "prefix": "aa",
    "body": "<a href=\"${1:#}\"${2: target=\"_blank\"}>${3:Texto del enlace}</a>$0",
    "description": "Etiqueta <a> con href"
  },
  "Enlace email": {
    "prefix": "amail",
    "body": "<a href=\"mailto:${1:email@ejemplo.com}\">${2:Enviar correo}</a>$0",
    "description": "Enlace mailto"
  },
  "Enlace teléfono": {
    "prefix": "atel",
    "body": "<a href=\"tel:${1:+34600000000}\">${2:Llamar}</a>$0",
