    "body": [
      "<ul>",
      "\t<li>${1:Elemento 1}</li>",
      "\t<li>${2:Elemento 2}</li>",
      "\t<li>${3:Elemento 3}</li>",
      "\t$0",
      "</ul>"
    ],
    "description": "Lista desordenada <ul>"
  },
  "Lista ordenada": {
    "prefix": "ol",
    "body": [
      "<ol>",
      "\t<li>${1:Elemento 1}</li>",
      "\t<li>${2:Elemento 2}</li>",
      "\t<li>${3:Elemento 3}</li>",
      "\t$0",
      "</ol>"
    ],
    "description": "Lista ordenada <ol>"
  },
  "Lista item": {
    "prefix": "li",
    "body": "<li>${1:Elemento}</li>$0",
    "description": "Elemento de lista <li>"
  },
  "Lista de definición": {
    "prefix": "dl",
    "body": [
