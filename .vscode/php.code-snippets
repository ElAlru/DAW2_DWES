  "Conexión PDO": {
    "prefix": "dbpdo",
    "body": [
      "try {",
      "\t\\$pdo = new PDO(",
      "\t\t'mysql:host=${1:localhost};dbname=${2:mi_base_datos};charset=utf8mb4',",
      "\t\t'${3:root}',",
      "\t\t'${4:}',",
      "\t\t[",
      "\t\t\tPDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,",
      "\t\t\tPDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,",
      "\t\t]",
      "\t);",
      "} catch (PDOException \\$e) {",
      "\tdie('Error de conexión: ' . \\$e->getMessage());",
      "}",
      "$0"
    ],
    "description": "Conexión PDO con manejo de errores"
  },
