  "Endpoint AJAX PHP": {
    "prefix": "ajaxphp",
    "body": [
      "<?php",
      "header('Content-Type: application/json; charset=UTF-8');",
      "",
      "\\$respuesta = ['exito' => false, 'mensaje' => '', 'datos' => null];",
      "",
      "if (\\$_SERVER['REQUEST_METHOD'] === 'POST') {",
      "\t// Leer datos JSON del body",
      "\t\\$input = json_decode(file_get_contents('php://input'), true);",
      "",
      "\t// O leer datos de formulario",
      "\t// \\$nombre = \\$_POST['nombre'] ?? '';",
      "",
      "\t\\$${1:nombre} = \\$input['${1:nombre}'] ?? '';",
      "",
      "\tif (!empty(\\$${1:nombre})) {",
      "\t\t\\$respuesta['exito'] = true;",
      "\t\t\\$respuesta['mensaje'] = 'Datos recibidos correctamente';",
      "\t\t\\$respuesta['datos'] = ['${1:nombre}' => \\$${1:nombre}];",
      "\t\t$0",
      "\t} else {",
      "\t\t\\$respuesta['mensaje'] = 'El campo ${1:nombre} es obligatorio';",
      "\t}",
      "} else {",
      "\t\\$respuesta['mensaje'] = 'Método no permitido';",
      "}",
      "",
      "echo json_encode(\\$respuesta);",
      "?>"
    ],
    "description": "Endpoint PHP para peticiones AJAX con respuesta JSON"
  },
  "Endpoint AJAX con FormData": {
    "prefix": "ajaxphpform",
    "body": [
      "<?php",
      "header('Content-Type: application/json; charset=UTF-8');",
      "",
      "\\$respuesta = ['exito' => false, 'mensaje' => ''];",
      "",
      "if (\\$_SERVER['REQUEST_METHOD'] === 'POST') {",
      "\t\\$nombre = trim(\\$_POST['nombre'] ?? '');",
      "\t\\$email = trim(\\$_POST['email'] ?? '');",
      "",
      "\tif (empty(\\$nombre) || empty(\\$email)) {",
      "\t\t\\$respuesta['mensaje'] = 'Todos los campos son obligatorios';",
      "\t} elseif (!filter_var(\\$email, FILTER_VALIDATE_EMAIL)) {",
      "\t\t\\$respuesta['mensaje'] = 'Email no válido';",
      "\t} else {",
      "\t\t\\$respuesta['exito'] = true;",
      "\t\t\\$respuesta['mensaje'] = \"Hola \\$nombre, datos recibidos.\";",
      "\t\t$0",
      "\t}",
      "}",
      "",
      "echo json_encode(\\$respuesta);",
      "?>"
    ],
    "description": "Endpoint PHP para AJAX con FormData (POST normal)"
  },

