{
  // ══════════════════════════════════════════════
  // ██  ESTRUCTURAS PHP                        ██
  // ══════════════════════════════════════════════

  "PHP tag": {
    "prefix": "php",
    "body": [
      "<?php",
      "$0",
      "?>"
    ],
    "description": "Bloque <?php ?>"
  },
  "PHP inline echo": {
    "prefix": "phpe",
    "body": "<?= ${1:\\$variable} ?>$0",
    "description": "<?= echo corto ?>"
  },

  // ══════════════════════════════════════════════
  // ██  VARIABLES Y OUTPUT                     ██
  // ══════════════════════════════════════════════

  "echo": {
    "prefix": "ec",
    "body": "echo \"$1\";$0",
    "description": "echo"
  },
  "echo HTML": {
    "prefix": "echtml",
    "body": "echo \"<${1:p}>$2</${1:p}>\";$0",
    "description": "echo con etiqueta HTML"
  },
  "var_dump": {
    "prefix": "vd",
    "body": "var_dump(${1:\\$variable});$0",
    "description": "var_dump para depuración"
  },
  "print_r": {
    "prefix": "pr",
    "body": "echo \"<pre>\"; print_r(${1:\\$variable}); echo \"</pre>\";$0",
    "description": "print_r con formato"
  },
  "Variable": {
    "prefix": "va",
    "body": "\\$${1:variable} = ${2:valor};$0",
    "description": "Declarar variable"
  },
  "Constante": {
    "prefix": "const",
    "body": "define('${1:NOMBRE}', ${2:'valor'});$0",
    "description": "Definir constante con define"
  },

  // ══════════════════════════════════════════════
  // ██  BUCLES                                  ██
  // ══════════════════════════════════════════════

  "foreach": {
    "prefix": "fore",
    "body": [
      "foreach (${1:\\$array} as ${2:\\$elemento}) {",
      "\t$0",
      "}"
    ],
    "description": "foreach"
  },
  "foreach key value": {
    "prefix": "forekv",
    "body": [
      "foreach (${1:\\$array} as ${2:\\$key} => ${3:\\$value}) {",
      "\t$0",
      "}"
    ],
    "description": "foreach con clave => valor"
  },
  "for loop": {
    "prefix": "forr",
    "body": [
      "for (\\$i = 0; \\$i < ${1:count(\\$array)}; \\$i++) {",
      "\t$0",
      "}"
    ],
    "description": "Bucle for"
  },
  "while": {
    "prefix": "wh",
    "body": [
      "while (${1:condicion}) {",
      "\t$0",
      "}"
    ],
    "description": "Bucle while"
  },
  "do while": {
    "prefix": "dow",
    "body": [
      "do {",
      "\t$0",
      "} while (${1:condicion});"
    ],
    "description": "Bucle do...while"
  },

  // ══════════════════════════════════════════════
  // ██  FUNCIONES                               ██
  // ══════════════════════════════════════════════

  "function": {
    "prefix": "fn",
    "body": [
      "function ${1:nombre}(${2:\\$params}) {",
      "\t$0",
      "}"
    ],
    "description": "Función PHP"
  },
  "function con return": {
    "prefix": "fnr",
    "body": [
      "function ${1:nombre}(${2:\\$params}) {",
      "\t$3",
      "\treturn ${4:\\$resultado};",
      "}"
    ],
    "description": "Función PHP con return"
  },
  "function con tipo": {
    "prefix": "fnt",
    "body": [
      "function ${1:nombre}(${2:string \\$param}): ${3:string} {",
      "\t$4",
      "\treturn ${5:\\$resultado};",
      "}"
    ],
    "description": "Función PHP con tipado"
  },

  // ══════════════════════════════════════════════
  // ██  CONDICIONALES                           ██
  // ══════════════════════════════════════════════

  "if": {
    "prefix": "iff",
    "body": [
      "if (${1:condicion}) {",
      "\t$0",
      "}"
    ],
    "description": "if"
  },
  "if else": {
    "prefix": "ife",
    "body": [
      "if (${1:condicion}) {",
      "\t$2",
      "} else {",
      "\t$0",
      "}"
    ],
    "description": "if...else"
  },
  "if elseif else": {
    "prefix": "ifelif",
    "body": [
      "if (${1:condicion1}) {",
      "\t$2",
      "} elseif (${3:condicion2}) {",
      "\t$4",
      "} else {",
      "\t$0",
      "}"
    ],
    "description": "if...elseif...else"
  },
  "switch": {
    "prefix": "sw",
    "body": [
      "switch (${1:\\$variable}) {",
      "\tcase ${2:valor1}:",
      "\t\t$3",
      "\t\tbreak;",
      "\tcase ${4:valor2}:",
      "\t\t$5",
      "\t\tbreak;",
      "\tdefault:",
      "\t\t$0",
      "\t\tbreak;",
      "}"
    ],
    "description": "Switch case"
  },
  "Ternario": {
    "prefix": "tern",
    "body": "\\$${1:resultado} = (${2:condicion}) ? ${3:verdadero} : ${4:falso};$0",
    "description": "Operador ternario"
  },
  "Null coalescing": {
    "prefix": "nc",
    "body": "\\$${1:resultado} = ${2:\\$variable} ?? ${3:'valor_defecto'};$0",
    "description": "Operador null coalescing (??)"
  },

  // ══════════════════════════════════════════════
  // ██  FORMULARIOS - GET/POST                  ██
  // ══════════════════════════════════════════════

  "isset GET": {
    "prefix": "iget",
    "body": [
      "if (isset(\\$_GET['${1:param}'])) {",
      "\t\\$${1:param} = \\$_GET['${1:param}'];",
      "\t$0",
      "}"
    ],
    "description": "Comprobar y recoger $_GET"
  },
  "isset POST": {
    "prefix": "ipost",
    "body": [
      "if (isset(\\$_POST['${1:param}'])) {",
      "\t\\$${1:param} = \\$_POST['${1:param}'];",
      "\t$0",
      "}"
    ],
    "description": "Comprobar y recoger $_POST"
  },
  "Recoger todo POST": {
    "prefix": "postall",
    "body": [
      "if (\\$_SERVER['REQUEST_METHOD'] === 'POST') {",
      "\t\\$${1:nombre} = isset(\\$_POST['${1:nombre}']) ? trim(\\$_POST['${1:nombre}']) : '';",
      "\t\\$${2:email} = isset(\\$_POST['${2:email}']) ? trim(\\$_POST['${2:email}']) : '';",
      "\t\\$${3:mensaje} = isset(\\$_POST['${3:mensaje}']) ? trim(\\$_POST['${3:mensaje}']) : '';",
      "\t$0",
      "}"
    ],
    "description": "Recoger múltiples campos POST con trim"
  },
  "Filter input": {
    "prefix": "filterinput",
    "body": "\\$${1:email} = filter_input(INPUT_${2|POST,GET|}, '${1:email}', ${3|FILTER_SANITIZE_EMAIL,FILTER_SANITIZE_SPECIAL_CHARS,FILTER_VALIDATE_EMAIL,FILTER_VALIDATE_INT,FILTER_VALIDATE_URL|});$0",
    "description": "filter_input para sanitizar/validar"
  },
  "htmlspecialchars": {
    "prefix": "hsc",
    "body": "htmlspecialchars(${1:\\$variable}, ENT_QUOTES, 'UTF-8')$0",
    "description": "htmlspecialchars para evitar XSS"
  },

  // ══════════════════════════════════════════════
  // ██  FORMULARIOS COMPLETOS EN PHP            ██
  // ══════════════════════════════════════════════

  "Formulario con procesamiento POST": {
    "prefix": "formphppost",
    "body": [
      "<?php",
      "\\$mensaje = '';",
      "\\$errores = [];",
      "",
      "if (\\$_SERVER['REQUEST_METHOD'] === 'POST') {",
      "\t// Recoger datos",
      "\t\\$nombre = isset(\\$_POST['nombre']) ? trim(\\$_POST['nombre']) : '';",
      "\t\\$email = isset(\\$_POST['email']) ? trim(\\$_POST['email']) : '';",
      "",
      "\t// Validar",
      "\tif (empty(\\$nombre)) {",
      "\t\t\\$errores[] = 'El nombre es obligatorio';",
      "\t}",
      "\tif (!filter_var(\\$email, FILTER_VALIDATE_EMAIL)) {",
      "\t\t\\$errores[] = 'Email no válido';",
      "\t}",
      "",
      "\tif (empty(\\$errores)) {",
      "\t\t\\$mensaje = 'Formulario enviado correctamente';",
      "\t\t$0",
      "\t}",
      "}",
      "?>",
      "<!DOCTYPE html>",
      "<html lang=\"es\">",
      "<head>",
      "\t<meta charset=\"UTF-8\">",
      "\t<title>${1:Formulario}</title>",
      "</head>",
      "<body>",
      "\t<?php if (!empty(\\$errores)): ?>",
      "\t\t<div style=\"color: red;\">",
      "\t\t\t<ul>",
      "\t\t\t\t<?php foreach (\\$errores as \\$error): ?>",
      "\t\t\t\t\t<li><?= htmlspecialchars(\\$error) ?></li>",
      "\t\t\t\t<?php endforeach; ?>",
      "\t\t\t</ul>",
      "\t\t</div>",
      "\t<?php endif; ?>",
      "",
      "\t<?php if (\\$mensaje): ?>",
      "\t\t<p style=\"color: green;\"><?= htmlspecialchars(\\$mensaje) ?></p>",
      "\t<?php endif; ?>",
      "",
      "\t<form method=\"POST\">",
      "\t\t<label for=\"nombre\">Nombre:</label>",
      "\t\t<input type=\"text\" id=\"nombre\" name=\"nombre\" value=\"<?= htmlspecialchars(\\$nombre ?? '') ?>\" required><br><br>",
      "",
      "\t\t<label for=\"email\">Email:</label>",
      "\t\t<input type=\"email\" id=\"email\" name=\"email\" value=\"<?= htmlspecialchars(\\$email ?? '') ?>\" required><br><br>",
      "",
      "\t\t<input type=\"submit\" value=\"Enviar\">",
      "\t</form>",
      "</body>",
      "</html>"
    ],
    "description": "Formulario PHP completo con validación POST y visualización de errores"
  },
  "Formulario con todos los inputs PHP": {
    "prefix": "formphpfull",
    "body": [
      "<?php",
      "if (\\$_SERVER['REQUEST_METHOD'] === 'POST') {",
      "\t// Campos de texto",
      "\t\\$nombre = trim(\\$_POST['nombre'] ?? '');",
      "\t\\$email = trim(\\$_POST['email'] ?? '');",
      "\t\\$password = \\$_POST['password'] ?? '';",
      "\t\\$telefono = trim(\\$_POST['telefono'] ?? '');",
      "\t\\$web = trim(\\$_POST['web'] ?? '');",
      "",
      "\t// Numéricos y fechas",
      "\t\\$edad = intval(\\$_POST['edad'] ?? 0);",
      "\t\\$fecha = \\$_POST['fecha'] ?? '';",
      "\t\\$hora = \\$_POST['hora'] ?? '';",
      "\t\\$color = \\$_POST['color'] ?? '#000000';",
      "\t\\$rango = intval(\\$_POST['rango'] ?? 50);",
      "",
      "\t// Selección",
      "\t\\$genero = \\$_POST['genero'] ?? '';",
      "\t\\$pais = \\$_POST['pais'] ?? '';",
      "\t\\$intereses = \\$_POST['intereses'] ?? [];",
      "\t\\$terminos = isset(\\$_POST['terminos']);",
      "",
      "\t// Textarea",
      "\t\\$comentario = trim(\\$_POST['comentario'] ?? '');",
      "",
      "\t// Mostrar resultados",
      "\techo \"<h2>Datos recibidos:</h2>\";",
      "\techo \"<p>Nombre: \" . htmlspecialchars(\\$nombre) . \"</p>\";",
      "\techo \"<p>Email: \" . htmlspecialchars(\\$email) . \"</p>\";",
      "\techo \"<p>Teléfono: \" . htmlspecialchars(\\$telefono) . \"</p>\";",
      "\techo \"<p>Edad: \\$edad</p>\";",
      "\techo \"<p>Fecha: \" . htmlspecialchars(\\$fecha) . \"</p>\";",
      "\techo \"<p>Género: \" . htmlspecialchars(\\$genero) . \"</p>\";",
      "\techo \"<p>País: \" . htmlspecialchars(\\$pais) . \"</p>\";",
      "\techo \"<p>Intereses: \" . implode(', ', array_map('htmlspecialchars', \\$intereses)) . \"</p>\";",
      "\techo \"<p>Color: \\$color</p>\";",
      "\techo \"<p>Rango: \\$rango</p>\";",
      "\techo \"<p>Términos aceptados: \" . (\\$terminos ? 'Sí' : 'No') . \"</p>\";",
      "\techo \"<p>Comentario: \" . nl2br(htmlspecialchars(\\$comentario)) . \"</p>\";",
      "}",
      "?>",
      "$0"
    ],
    "description": "Procesamiento PHP de formulario con TODOS los tipos de input"
  },
  "Formulario registro PHP completo": {
    "prefix": "formphpregistro",
    "body": [
      "<?php",
      "\\$errores = [];",
      "\\$exito = false;",
      "",
      "if (\\$_SERVER['REQUEST_METHOD'] === 'POST') {",
      "\t\\$nombre = trim(\\$_POST['nombre'] ?? '');",
      "\t\\$email = trim(\\$_POST['email'] ?? '');",
      "\t\\$password = \\$_POST['password'] ?? '';",
      "\t\\$password2 = \\$_POST['password2'] ?? '';",
      "\t\\$telefono = trim(\\$_POST['telefono'] ?? '');",
      "\t\\$fechaNac = \\$_POST['fechaNac'] ?? '';",
      "\t\\$genero = \\$_POST['genero'] ?? '';",
      "\t\\$pais = \\$_POST['pais'] ?? '';",
      "\t\\$terminos = isset(\\$_POST['terminos']);",
      "",
      "\t// Validaciones",
      "\tif (empty(\\$nombre)) \\$errores[] = 'El nombre es obligatorio';",
      "\tif (strlen(\\$nombre) < 2) \\$errores[] = 'El nombre debe tener al menos 2 caracteres';",
      "\tif (!filter_var(\\$email, FILTER_VALIDATE_EMAIL)) \\$errores[] = 'Email no válido';",
      "\tif (strlen(\\$password) < 6) \\$errores[] = 'La contraseña debe tener al menos 6 caracteres';",
      "\tif (\\$password !== \\$password2) \\$errores[] = 'Las contraseñas no coinciden';",
      "\tif (!empty(\\$telefono) && !preg_match('/^[0-9]{9}$/', \\$telefono)) \\$errores[] = 'Teléfono no válido (9 dígitos)';",
      "\tif (!\\$terminos) \\$errores[] = 'Debes aceptar los términos';",
      "",
      "\tif (empty(\\$errores)) {",
      "\t\t\\$exito = true;",
      "\t\t// Aquí iría: guardar en BD, enviar email, etc.",
      "\t\t$0",
      "\t}",
      "}",
      "?>"
    ],
    "description": "Registro PHP con validación completa"
  },

  // ══════════════════════════════════════════════
  // ██  SUBIDA DE ARCHIVOS                      ██
  // ══════════════════════════════════════════════

  "Subida de archivo PHP": {
    "prefix": "phpupload",
    "body": [
      "if (isset(\\$_FILES['${1:archivo}']) && \\$_FILES['${1:archivo}']['error'] === UPLOAD_ERR_OK) {",
      "\t\\$nombreArchivo = \\$_FILES['${1:archivo}']['name'];",
      "\t\\$tmpArchivo = \\$_FILES['${1:archivo}']['tmp_name'];",
      "\t\\$tamano = \\$_FILES['${1:archivo}']['size'];",
      "\t\\$tipo = \\$_FILES['${1:archivo}']['type'];",
      "",
      "\t// Validar extensión",
      "\t\\$extensionesPermitidas = ['jpg', 'jpeg', 'png', 'gif', 'pdf'];",
      "\t\\$extension = strtolower(pathinfo(\\$nombreArchivo, PATHINFO_EXTENSION));",
      "",
      "\tif (!in_array(\\$extension, \\$extensionesPermitidas)) {",
      "\t\techo 'Extensión no permitida';",
      "\t} elseif (\\$tamano > ${2:5} * 1024 * 1024) {",
      "\t\techo 'Archivo demasiado grande (máx ${2:5}MB)';",
      "\t} else {",
      "\t\t\\$destino = '${3:uploads/}' . uniqid() . '.' . \\$extension;",
      "\t\tif (move_uploaded_file(\\$tmpArchivo, \\$destino)) {",
      "\t\t\techo 'Archivo subido correctamente: ' . \\$destino;",
      "\t\t} else {",
      "\t\t\techo 'Error al mover el archivo';",
      "\t\t}",
      "\t}",
      "}",
      "$0"
    ],
    "description": "Subida de archivo con validaciones"
  },

  // ══════════════════════════════════════════════
  // ██  SESIONES                                ██
  // ══════════════════════════════════════════════

  "session_start": {
    "prefix": "sess",
    "body": "session_start();$0",
    "description": "Iniciar sesión"
  },
  "Crear sesión": {
    "prefix": "sessset",
    "body": "\\$_SESSION['${1:clave}'] = ${2:'valor'};$0",
    "description": "Guardar dato en sesión"
  },
  "Leer sesión": {
    "prefix": "sessget",
    "body": "\\$${1:dato} = \\$_SESSION['${2:clave}'] ?? ${3:null};$0",
    "description": "Leer dato de sesión con fallback"
  },
  "Comprobar sesión (login)": {
    "prefix": "sesscheck",
    "body": [
      "session_start();",
      "if (!isset(\\$_SESSION['${1:usuario}'])) {",
      "\theader('Location: ${2:login.php}');",
      "\texit();",
      "}",
      "$0"
    ],
    "description": "Comprobar si el usuario está logueado"
  },
  "Destruir sesión (logout)": {
    "prefix": "sessdestroy",
    "body": [
      "session_start();",
      "session_unset();",
      "session_destroy();",
      "header('Location: ${1:login.php}');",
      "exit();",
      "$0"
    ],
    "description": "Cerrar sesión completa"
  },
  "Login PHP completo": {
    "prefix": "phplogin",
    "body": [
      "<?php",
      "session_start();",
      "\\$error = '';",
      "",
      "if (\\$_SERVER['REQUEST_METHOD'] === 'POST') {",
      "\t\\$usuario = trim(\\$_POST['usuario'] ?? '');",
      "\t\\$password = \\$_POST['password'] ?? '';",
      "",
      "\t// Aquí normalmente consultarías la BD",
      "\t\\$usuarioCorrecto = '${1:admin}';",
      "\t\\$passwordCorrecto = '${2:1234}';",
      "",
      "\tif (\\$usuario === \\$usuarioCorrecto && \\$password === \\$passwordCorrecto) {",
      "\t\t\\$_SESSION['usuario'] = \\$usuario;",
      "\t\t\\$_SESSION['logueado'] = true;",
      "\t\theader('Location: ${3:panel.php}');",
      "\t\texit();",
      "\t} else {",
      "\t\t\\$error = 'Usuario o contraseña incorrectos';",
      "\t}",
      "}",
      "?>",
      "$0"
    ],
    "description": "Sistema de login PHP con sesiones"
  },

